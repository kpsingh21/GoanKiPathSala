<?php

/**
 * Implements hook_schema().
 */
function result_management_schema() {

  $schema['result'] = [
    'description' => 'Stores the result of student',
    'fields' => [
      'id' => [
        'type' => 'serial',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ],
      'student_uid' => [
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ],
      'academic_year_id' => [
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ],
      'roll_no' => [
        'type' => 'varchar',
        'length' => 50,
        'not null' => TRUE,
      ],
      'subject_tid' => [
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ],
      'marks' => [
        'type' => 'int',
        'not null' => TRUE,
      ],
    ],
    'primary key' => ['id'],
    'indexes' => [
      'student_uid' => ['student_uid'],
      'academic_year_id' => ['academic_year_id'],
    ],
  ];

  return $schema;
}
